{
  "mcpServers": {
    "anypoint-connect": {
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/anypoint-connect@0.17.0",
        "mcp"
      ]
    },
    "mule-build": {
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/mule-build@3.1.0",
