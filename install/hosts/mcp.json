{
  "mcpServers": {
    "anypoint-connect": {
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/anypoint-connect@0.12.0",
        "mcp"
      ]
    },
    "mule-build": {
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/mule-build@2.2.0",
