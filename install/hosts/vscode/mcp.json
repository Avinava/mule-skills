{
  "servers": {
    "anypoint-connect": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/anypoint-connect@0.13.0",
        "mcp"
      ]
    },
    "mule-build": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/mule-build@2.3.0",
        "mcp"
      ]
    },
    "mule-lint": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sfdxy/mule-lint@1.30.0",
        "mcp"
      ]
    }
  }
}
