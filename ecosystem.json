{
  "schemaVersion": 1,
  "bundleVersion": "1.9.0",
  "packages": {
    "anypoint-connect": {
      "npm": "@sfdxy/anypoint-connect",
      "version": "0.15.0",
      "node": ">=22.0.0",
      "role": "Authorized Anypoint evidence, Design Center workflows, and lifecycle operations",
      "credentials": "Anypoint Platform login",
      "repository": "https://github.com/Avinava/anypoint-connect",
      "documentation": "https://avinava.github.io/anypoint-connect/"
    },
    "mule-build": {
      "npm": "@sfdxy/mule-build",
      "version": "3.0.0",
      "node": ">=20.19.0",
      "role": "Validate, test, package, run locally, and prepare versioned and tagged Mule artifacts",
      "credentials": "None",
      "repository": "https://github.com/Avinava/mule-build",
      "documentation": "https://avinava.github.io/mule-build/"
    },
    "mule-lint": {
      "npm": "@sfdxy/mule-lint",
      "version": "2.0.0",
      "node": ">=20.0.0",
      "role": "Canonical standards, Mule static analysis, XML formatting, and RAML/OAS contract validation",
      "credentials": "None",
      "repository": "https://github.com/Avinava/mule-lint",
      "documentation": "https://avinava.github.io/mule-lint/"
    }
  },
  "capabilities": {
    "anypoint-connect": {
      "tools": {
        "search_exchange": {
          "query": "string"
        },
        "publish_app_jar": {
          "jarPath": "string",
          "confirm": "boolean"
        }
      },
      "resources": [],
      "examples": {
        "search_exchange": [
          {
            "query": "synthetic"
          }
        ],
        "publish_app_jar": [
          {
            "jarPath": "/synthetic/example.jar"
          },
          {
            "jarPath": "/synthetic/example.jar",
            "confirm": false
          }
        ]
      }
    },
    "mule-build": {
      "tools": {
        "run_build": {
          "cwd": "string"
        },
        "run_tests": {
          "cwd": "string"
        },
        "get_project_config": {
          "cwd": "string"
        }
      },
      "resources": [],
      "examples": {
        "run_build": [
          {},
          {
            "cwd": "."
          }
        ],
        "run_tests": [
          {},
          {
            "cwd": "."
          }
        ],
        "get_project_config": [
          {},
          {
            "cwd": "."
          }
        ]
      }
    },
    "mule-lint": {
      "tools": {
        "run_lint_analysis": {
          "projectPath": "string",
          "profile": "string"
        },
        "validate_snippet": {
          "code": "string",
          "type": "string"
        }
      },
      "resources": [
        "mule-lint://rules",
        "mule-lint://standards"
      ],
      "examples": {
        "run_lint_analysis": [
          {
            "projectPath": "/synthetic/project"
          },
          {
            "projectPath": "/synthetic/project",
            "profile": "recommended"
          }
        ],
        "validate_snippet": [
          {
            "code": "<mule/>",
            "type": "xml"
          }
        ]
      }
    }
  }
}
